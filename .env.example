# Neon Postgres — يملؤها `neon deploy` / `neon env pull`
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""
# سرّ توقيع جلسات الدخول — غيّره لقيمة عشوائية طويلة
AUTH_SECRET="change-me-to-a-long-random-string"
APP_URL="http://localhost:3000"

# حساب المدير الأول (يُنشأ عبر npm run setup)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin12345"

# Stripe — اتركها فارغة لتشغيل وضع الدفع التجريبي (للتطوير فقط)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_YEARLY=""
# true = تفعيل الاشتراك بدون دفع حقيقي عند غياب مفاتيح Stripe (لا تستخدمه في الإنتاج)
PAYMENTS_DEMO="true"

# البريد (SMTP) — لتأكيد البريد وإعادة تعيين كلمة المرور. بدونه تُطبع الروابط في سجل الخادم
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="منصتي <no-reply@example.com>"

# Neon Object Storage (حاوية assets في neon.ts) — يملؤها `neon deploy`. فارغة = تخزين على القرص المحلي
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3=""
AWS_REGION=""
