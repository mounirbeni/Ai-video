DATABASE_URL="file:./dev.db"
# سرّ توقيع جلسات الدخول — غيّره لقيمة عشوائية طويلة
AUTH_SECRET="change-me-to-a-long-random-string"
APP_URL="http://localhost:3000"

# حساب المدير الأول (يُنشأ عبر npm run setup)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin12345"

# Stripe — اتركها فارغة لتشغيل وضع الدفع التجريبي (للتطوير فقط)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_YEARLY=""
# true = تفعيل الاشتراك بدون دفع حقيقي عند غياب مفاتيح Stripe (لا تستخدمه في الإنتاج)
PAYMENTS_DEMO="true"
