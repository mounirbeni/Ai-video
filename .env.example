# Neon Postgres
DATABASE_URL=""
# DATABASE_URL_UNPOOLED=""  # فقط مع Prisma <5.10
# Production requires a unique random secret of at least 32 characters.
AUTH_SECRET=""
APP_URL="http://localhost:3000"

# حساب المدير الأول (يُنشأ عبر npm run setup)
ADMIN_EMAIL="admin@example.com"
# كلمة مرور قوية (10 أحرف على الأقل) — تُرفض القيم الافتراضية
ADMIN_PASSWORD=""

# بريد المطوّر الموثّق: يمنحه شارة المطوّر ونشر المجتمع فقط (اختياري)
DEVELOPER_EMAIL=""

# سرّ استدعاء مهمة التنظيف الدورية /api/cron/cleanup (يرسله Vercel Cron تلقائيًا)
CRON_SECRET=""

# البريد (SMTP) — لتأكيد البريد وإعادة تعيين كلمة المرور. بدونه تُطبع الروابط في سجل الخادم
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="منصتي <no-reply@example.com>"

# Vercel Blob (حاوية خاصة) — يُحقن تلقائيًا عند ربطها بالمشروع. فارغ = تخزين على القرص المحلي
BLOB_READ_WRITE_TOKEN=""

# مدة صلاحية رابط الفيديو بالثواني
STREAM_URL_TTL="600"

# PayPal (Live) — الدفع والتبرعات
PAYPAL_CLIENT_ID=""
PAYPAL_SECRET=""
# PAYPAL_ENV="sandbox"  # للتجربة فقط
