{
  "name": "ai-video",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/prepare-production.mjs && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "db:push": "prisma db push",
    "db:seed": "node --env-file=.env prisma/seed.mjs",
    "setup": "prisma db push && node --env-file=.env prisma/seed.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration.test.ts",
    "db:upgrade": "prisma db execute --file prisma/updates/20261025-security-library.sql --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "@prisma/client": "5.22.0",
    "@vercel/blob": "^2.8.2",
    "bcryptjs": "2.4.3",
    "hls.js": "^1.7.3",
    "jose": "5.9.6",
    "next": "16.4.3",
    "nodemailer": "^10.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stripe": "17.4.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "prisma": "5.22.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "5.7.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "^4.6.6"
    },
    "tailwindcss": {
      "postcss-selector-parser": "^7.1.7"
    },
    "postcss-nested": {
      "postcss-selector-parser": "^7.1.7"
    }
  }
}
