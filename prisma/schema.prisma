generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // Neon pooled (-pooler)
  // uncomment next line if you use Prisma <5.10
  // directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String
  passwordHash       String
  role               String    @default("USER") // USER | ADMIN
  stripeCustomerId   String?   @unique
  paddleCustomerId   String?   @unique
  subscriptionId     String?
  subscriptionStatus String    @default("none") // none | active | trialing | past_due | canceled
  subscriptionPlan   String?
  currentPeriodEnd   DateTime?
  emailVerified      DateTime?
  createdAt          DateTime  @default(now())
  progress           WatchProgress[]
  tokens             AuthToken[]
  streams            ActiveStream[]
}

// الأجهزة التي تشاهد حاليًا — لمنع مشاركة الحساب
model ActiveStream {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId String
  lastSeen DateTime @default(now())

  @@unique([userId, deviceId])
}

model AuthToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // VERIFY | RESET
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Title {
  id          String    @id @default(cuid())
  slug        String    @unique
  type        String // MOVIE | SERIES
  name        String
  description String
  year        Int?
  genres      String    @default("") // مفصولة بفواصل
  posterUrl   String?
  backdropUrl String?
  trailerUrl  String?
  videoSrc    String? // للأفلام: local:<file> أو رابط https
  duration    Int? // بالدقائق
  isFree      Boolean   @default(false)
  featured    Boolean   @default(false)
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  episodes    Episode[]
}

model Episode {
  id          String  @id @default(cuid())
  titleId     String
  title       Title   @relation(fields: [titleId], references: [id], onDelete: Cascade)
  season      Int     @default(1)
  number      Int
  name        String
  description String  @default("")
  videoSrc    String
  duration    Int?
  isFree      Boolean @default(false)

  @@unique([titleId, season, number])
}

model WatchProgress {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String // titleId أو episodeId
  seconds   Float
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
}
