generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // Neon pooled (-pooler)
  // uncomment next line if you use Prisma <5.10
  // directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id                 String           @id @default(cuid())
  email              String           @unique
  username           String?          @unique // يظهر كعلامة مائية على الفيديو
  name               String
  passwordHash       String
  sessionVersion     Int              @default(0)
  role               String           @default("USER") // USER | ADMIN
  stripeCustomerId   String?          @unique
  paddleCustomerId   String?          @unique
  subscriptionId     String?
  subscriptionStatus String           @default("none") // none | active | trialing | past_due | canceled
  subscriptionPlan   String?
  currentPeriodEnd   DateTime?
  accessUntil        DateTime? // أيام مشاهدة مُهداة مع باقات الدعم (مستقلة عن الاشتراك)
  accessPlan         String? // monthly | yearly: آخر خطة مدفوعة مسبقًا، تحدد عدد الشاشات
  supporterSince     DateTime?
  emailVerified      DateTime?
  createdAt          DateTime         @default(now())
  progress           WatchProgress[]
  tokens             AuthToken[]
  streams            ActiveStream[]
  supports           Support[]
  payments           PaymentRequest[]
  watchlist          Watchlist[]
}

// دفعات الدعم لمرة واحدة؛ المعرّف هو رقم معاملة Paddle فلا تُحتسب الدفعة مرتين عند إعادة إرسال الإشعار
model Support {
  id          String   @id
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier        String
  amountCents Int
  createdAt   DateTime @default(now())
}

// الأجهزة التي تشاهد حاليًا — لمنع مشاركة الحساب
model ActiveStream {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId String
  lastSeen DateTime @default(now())

  @@unique([userId, deviceId])
}

model AuthToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // VERIFY | RESET
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Title {
  id              String    @id @default(cuid())
  slug            String    @unique
  type            String // MOVIE | SERIES
  name            String
  description     String
  // الحقول الأساسية بالإنجليزية (لغة الموقع الافتراضية)، وهذه نسختها العربية
  nameAr          String?
  descriptionAr   String?
  genresAr        String?
  releaseLabelAr  String?
  year            Int?
  genres          String    @default("") // مفصولة بفواصل
  posterUrl       String?
  backdropUrl     String?
  trailerUrl      String?
  videoSrc        String? // للأفلام: local:<file> أو رابط https
  subtitles       Json      @default("[]")
  streamFormat    String    @default("file") // file | hls
  duration        Int? // بالدقائق — للأفلام فقط
  plannedEpisodes Int? // للمسلسلات: عدد الحلقات المعلن قبل رفعها
  language        String? // رمز لغة العمل الأصلية مثل en
  isFree          Boolean   @default(false)
  featured        Boolean   @default(false)
  comingSoon      Boolean   @default(false) // يُعرض في «قريبًا» ولا يمكن مشاهدته بعد
  releaseLabel    String? // مثل «ديسمبر 2026»
  published       Boolean   @default(true)
  createdAt       DateTime  @default(now())
  episodes        Episode[]
  watchlist       Watchlist[]
}

model Episode {
  id            String  @id @default(cuid())
  titleId       String
  title         Title   @relation(fields: [titleId], references: [id], onDelete: Cascade)
  season        Int     @default(1)
  number        Int
  name          String
  description   String  @default("")
  nameAr        String?
  descriptionAr String?
  videoSrc      String
  subtitles     Json    @default("[]")
  streamFormat  String  @default("file")
  thumbUrl      String? // صورة الحلقة (16:9)
  duration      Int?
  isFree        Boolean @default(false)

  @@unique([titleId, season, number])
}

model WatchProgress {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String // titleId أو episodeId
  seconds   Float
  completed Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
}

model Watchlist {
  userId    String
  titleId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, titleId])
}

model RateLimit {
  key       String   @id
  attempts  Int
  expiresAt DateTime

  @@index([expiresAt])
}

// الدفع اليدوي: تحويل بنكي/CashPlus/… يؤكده المدير يدويًا من لوحة الإدارة
model PaymentRequest {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  item       String // monthly | yearly | fan | supporter | producer
  method     String
  reference  String?
  receiptKey String? // مسار صورة الإيصال في التخزين الخاص
  status     String    @default("pending") // pending | approved | rejected
  createdAt  DateTime  @default(now())
  decidedAt  DateTime?
}

// أكواد تفعيل مسبقة الدفع تباع خارج الموقع
model ActivationCode {
  code      String    @id
  item      String
  usedById  String?
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// إعدادات قابلة للتعديل من لوحة الإدارة (مثل طرق الدفع اليدوي)
model Setting {
  key   String @id
  value String
}
